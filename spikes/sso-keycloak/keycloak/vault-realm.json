{
  "realm": "vault",
  "enabled": true,
  "accessTokenLifespan": 600,
  "oauth2DeviceCodeLifespan": 600,
  "clients": [
    {
      "clientId": "schedulevault",
      "name": "ScheduleVault desktop",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://127.0.0.1/*"
      ],
      "webOrigins": [],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true",
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "vault_login",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "vault_login",
            "claim.name": "vault_login",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "vault-db audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "vault-db",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "vault-db",
      "name": "Vault database (token introspection)",
      "publicClient": false,
      "secret": "vault-db-spike-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "vault-manager",
      "name": "Schedule Vault Manager (assigns Vault logins)",
      "publicClient": false,
      "secret": "vault-manager-spike-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "svt_alice",
      "enabled": true,
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Example",
      "credentials": [
        {
          "type": "password",
          "value": "testuser1",
          "temporary": false
        }
      ],
      "attributes": {
        "vault_login": [
          "svt_alice"
        ]
      }
    },
    {
      "username": "svt_bob",
      "enabled": true,
      "email": "bob@example.com",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Example",
      "credentials": [
        {
          "type": "password",
          "value": "testuser1",
          "temporary": false
        }
      ],
      "attributes": {
        "vault_login": [
          "svt_bob"
        ]
      }
    },
    {
      "username": "service-account-vault-manager",
      "enabled": true,
      "serviceAccountClientId": "vault-manager",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "manage-users",
          "view-identity-providers"
        ]
      }
    }
  ],
  "identityProviders": [
    {
      "alias": "acme",
      "displayName": "Acme Corp (own provider)",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "issuer": "http://localhost:8080/realms/acme-idp",
        "authorizationUrl": "http://localhost:8080/realms/acme-idp/protocol/openid-connect/auth",
        "tokenUrl": "http://localhost:8080/realms/acme-idp/protocol/openid-connect/token",
        "jwksUrl": "http://localhost:8080/realms/acme-idp/protocol/openid-connect/certs",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "clientId": "vault-broker",
        "clientSecret": "acme-broker-spike-secret",
        "clientAuthMethod": "client_secret_post",
        "defaultScope": "openid profile email",
        "syncMode": "FORCE",
        "updateProfileFirstLoginMode": "off"
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"vault_login\", \"displayName\": \"Vault login\", \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}}], \"groups\": []}"
          ]
        }
      }
    ]
  }
}