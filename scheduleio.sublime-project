{
	"folders":
	[
		{
			"path": ".",
			"file_exclude_patterns": ["*.sublime-workspace", ".gitattributes", ".*"],
			"folder_exclude_patterns": ["build", "__pycache__", ".git"],
			"binary_file_patterns": ["*.so", "*.so.*", "*.a", "*.o", "*.dll", "*.dylib", "*.exe", "*.db"],
		},
	],
	"build_systems":
	[
		{
			"name": "ScheduleIO — Build Debug",
			"selector": "source.c++, source.c",
			"shell_cmd": "cmake --build build",
			"file_regex": "^(..[^:]*):([0-9]+):?([0-9]+)?:? (.*)$",
			"working_dir": "$project_path"
		},
		{
			"name": "ScheduleIO — Configure & Build Debug",
			"selector": "source.c++, source.c",
			"shell_cmd": "cmake -S . -B build && cmake --build build",
			"file_regex": "^(..[^:]*):([0-9]+):?([0-9]+)?:? (.*)$",
			"working_dir": "$project_path"
		},
		{
			"name": "ScheduleIO — Build Release",
			"selector": "source.c++, source.c",
			"shell_cmd": "cmake --build build --config Release",
			"file_regex": "^(..[^:]*):([0-9]+):?([0-9]+)?:? (.*)$",
			"working_dir": "$project_path"
		},
		{
			"name": "ScheduleIO — Clean",
			"selector": "source.c++, source.c",
			"shell_cmd": "cmake --build build --target clean",
			"file_regex": "^(..[^:]*):([0-9]+):?([0-9]+)?:? (.*)$",
			"working_dir": "$project_path"
		},
		{
			"name": "ScheduleIO — Build & Test (Debug)",
			"shell_cmd": "cmake --build build && ctest --test-dir build --output-on-failure",
			"file_regex": "^(..[^:]*):([0-9]+):?([0-9]+)?:? (.*)$",
			"working_dir": "$project_path"
		},
		{
			"name": "ScheduleIO — Build & Test (Release)",
			"shell_cmd": "cmake --build build --config Release && ctest --test-dir build --output-on-failure",
			"file_regex": "^(..[^:]*):([0-9]+):?([0-9]+)?:? (.*)$",
			"working_dir": "$project_path"
		},
	],
}
